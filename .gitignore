.DS_Store
Thumbs.db

# Solver intermediate exports — regenerated from xlsx + code on each run.
# The CLIENT-FACING zips in bundle_for_columbus/ ARE versioned.
scheduler/data/columbus_full_hs/
scheduler/data/columbus_full_hs_v2/
scheduler/data/columbus_full_hs_v3/
scheduler/data/columbus_full_hs_v4/
scheduler/data/columbus_full_hs_v5/
scheduler/data/columbus_full_hs_v6/
scheduler/data/columbus_synthetic_ms/
scheduler/data/columbus_synthetic_ms_v2/
scheduler/data/_client_bundle_v2/
scheduler/data/_client_bundle_v3/
scheduler/data/exports/
scheduler/data/columbus/
scheduler/data/columbus_exports/

# SQLite databases — created by persistence layer (v4.27+).
# Default path: scheduler/data/columbus.sqlite (override via $COLUMBUS_DB).
scheduler/data/*.sqlite
scheduler/data/*.sqlite-journal
scheduler/data/*.sqlite-wal
scheduler/data/*.sqlite-shm

# Real student data — NEVER commit. Includes names, IDs, and counselor notes.
# The cleanup folder is a working area for transforming real xlsx files.
scheduler/data/cleanup/
scheduler/data/*.xlsx
# Whitelist sample/template xlsx files explicitly if any get added.
!scheduler/data/sample_template.xlsx

# Streamlit — ignore everywhere EXCEPT the deployable config we ship.
.streamlit/
!scheduler/.streamlit/
!scheduler/.streamlit/config.toml

# Generated demo poster HTMLs — committed under HS_2026-2027_real for client preview.
# Regenerate any time with: scheduler/scripts/generate_demo_posters.py
