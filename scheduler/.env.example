# Variables de entorno para docker-compose. Copia a `.env` y edita.
# .env NO debe ir a git (ya está en .gitignore via *.env pattern).

# Password compartido entre el personal autorizado.
# Mínimo 16 caracteres recomendado.
APP_PASSWORD=cambiar-este-password

# Puerto en el host. Default 8501.
PORT=8501
